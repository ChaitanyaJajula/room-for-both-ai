# Public, non-secret setting. Never put API keys or credentials in NEXT_PUBLIC_* variables.
# Local development: the FastAPI server started with uvicorn on port 8000.
# Production (Vercel): set this in the Vercel dashboard to the Render service's HTTPS URL,
# e.g. https://your-service.onrender.com (no trailing slash needed). It is read at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
